# Server Configuration
PORT=3001
NODE_ENV=development
API_BASE=

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/cultural_board
# OR for MongoDB Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/cultural_board?retryWrites=true&w=majority

# Admin Panel Credentials
# WARNING: generate strong unique values, never commit real secrets,
# never run with template defaults. App refuses to start if unset.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Session & Cookie Configuration
# WARNING: use long random strings (>=32 chars), all different, never reuse defaults.
COOKIE_NAME=adminjs
COOKIE_PASSWORD=
SESSION_SECRET=
